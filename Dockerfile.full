# webscan-light "full" image: the slim app PLUS the optional external engines
# (nuclei + nmap) baked in, with nuclei templates pre-fetched at build time.
# The default Dockerfile stays lean; use this only when you want the adapters.

FROM golang:1.26-bookworm AS nuclei-build
# GOTOOLCHAIN=auto lets `go install` fetch a newer toolchain if a future nuclei
# release requires one, so this build does not break on the next Go bump.
ENV GOTOOLCHAIN=auto
RUN go install github.com/projectdiscovery/nuclei/v3/cmd/nuclei@latest

FROM python:3.12-slim

# chromium: PDF/JS-render/screenshots. nmap: the nmap adapter. ca-certificates: TLS.
RUN apt-get update \
 && apt-get install -y --no-install-recommends chromium ca-certificates nmap \
 && rm -rf /var/lib/apt/lists/*

COPY --from=nuclei-build /go/bin/nuclei /usr/local/bin/nuclei

ENV WEBSCAN_CHROME=/usr/bin/chromium \
    WEBSCAN_CACHE_DIR=/cache \
    WEBSCAN_DATA_DIR=/data \
    PYTHONUNBUFFERED=1

WORKDIR /app
COPY pyproject.toml README.md ./
COPY webscan ./webscan
RUN pip install --no-cache-dir ".[web,cli]"

RUN useradd --create-home --uid 10001 scanner \
 && mkdir -p /cache /data && chown scanner /cache /data
USER scanner

# Pre-fetch nuclei templates so the first scan works without a network fetch.
RUN nuclei -update-templates -disable-update-check || true

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=5s --retries=3 \
  CMD python -c "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health',timeout=4).status==200 else 1)"
ENTRYPOINT ["webscan"]
CMD ["serve", "--host", "0.0.0.0", "--port", "8000"]
