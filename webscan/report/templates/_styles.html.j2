<style>
  :root {
    --ink:#0f172a; --muted:#64748b; --faint:#94a3b8;
    --line:#e6eaf0; --line-soft:#eef1f6; --bg:#f4f6fb; --card:#ffffff; --panel:#f8fafc;
    --accent:#4f46e5; --accent-soft:#eef2ff;
    --track:#eef1f6;
    --critical:#8b1a1a; --high:#e5484d; --medium:#f5a524; --low:#4b7bec; --info:#12b886;
    --shadow:0 1px 2px rgba(15,23,42,.04), 0 8px 24px -12px rgba(15,23,42,.14);
    --radius:16px;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --ink:#e8edf5; --muted:#9aa6b8; --faint:#6b7688;
      --line:#232b3a; --line-soft:#1c2432; --bg:#0b0f17; --card:#141b26; --panel:#0f1620;
      --accent:#7c8cff; --accent-soft:#1b2136;
      --track:#232b3a;
      --critical:#c0392b; --high:#f2555a; --medium:#f7b955; --low:#5b8def; --info:#20c997;
      --shadow:0 1px 2px rgba(0,0,0,.3), 0 10px 30px -12px rgba(0,0,0,.6);
    }
  }
  :root[data-theme="dark"] {
    --ink:#e8edf5; --muted:#9aa6b8; --faint:#6b7688;
    --line:#232b3a; --line-soft:#1c2432; --bg:#0b0f17; --card:#141b26; --panel:#0f1620;
    --accent:#7c8cff; --accent-soft:#1b2136; --track:#232b3a;
    --critical:#c0392b; --high:#f2555a; --medium:#f7b955; --low:#5b8def; --info:#20c997;
    --shadow:0 1px 2px rgba(0,0,0,.3), 0 10px 30px -12px rgba(0,0,0,.6);
  }
  * { box-sizing:border-box; }
  html { -webkit-text-size-adjust:100%; }
  body {
    margin:0; background:var(--bg); color:var(--ink);
    font:14.5px/1.6 ui-sans-serif,system-ui,-apple-system,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;
    -webkit-font-smoothing:antialiased;
  }
  .sheet { max-width:1000px; margin:0 auto; padding:40px 28px 72px; }
  a { color:var(--accent); text-decoration:none; word-break:break-word; }
  a:hover { text-decoration:underline; }
  h1,h2,h3 { letter-spacing:-.02em; }

  /* ---- Masthead ---- */
  .masthead { display:flex; align-items:flex-start; gap:16px; flex-wrap:wrap;
              margin-bottom:26px; }
  .masthead .glyph {
    width:44px; height:44px; border-radius:12px; flex:none;
    background:linear-gradient(135deg,var(--accent),color-mix(in srgb,var(--accent) 55%,#000));
    display:grid; place-items:center; color:#fff; font-size:22px;
    box-shadow:var(--shadow);
  }
  .masthead h1 { font-size:22px; margin:0 0 2px; }
  .masthead .sub { color:var(--muted); font-size:13px; }
  .masthead .sub a { font-weight:600; }
  .masthead .spacer { flex:1; }
  .scan-type-pill {
    align-self:center; font-size:12px; font-weight:600; color:var(--accent);
    background:var(--accent-soft); border:1px solid color-mix(in srgb,var(--accent) 22%,transparent);
    padding:5px 12px; border-radius:99px; white-space:nowrap;
  }

  .notice {
    display:flex; gap:10px; margin:0 0 26px; padding:13px 16px; border-radius:12px;
    background:var(--panel); border:1px solid var(--line-soft); color:var(--muted); font-size:12.5px;
  }
  .notice::before { content:"ℹ"; color:var(--accent); font-weight:700; }

  section.block { margin:0 0 22px; }
  .eyebrow { font-size:11px; font-weight:700; letter-spacing:.12em; text-transform:uppercase;
             color:var(--faint); margin:0 0 12px; }

  /* ---- Hero dashboard ---- */
  .hero { display:grid; grid-template-columns:minmax(220px,.85fr) 2fr; gap:16px; }
  .card { background:var(--card); border:1px solid var(--line); border-radius:var(--radius);
          box-shadow:var(--shadow); }
  .risk-card { padding:26px 24px; display:flex; flex-direction:column; justify-content:center;
               position:relative; overflow:hidden; }
  .risk-card::before {
    content:""; position:absolute; inset:0 auto 0 0; width:5px;
    background:var(--risk-color,var(--info));
  }
  .risk-card .eyebrow { margin-bottom:6px; }
  .risk-word { font-size:40px; font-weight:800; line-height:1; color:var(--risk-color); }
  .risk-meta { margin-top:14px; font-size:12.5px; color:var(--muted); }
  .risk-meta b { color:var(--ink); font-weight:600; }

  .gauges-card { padding:20px 18px 8px; }
  .gauge-row { display:flex; justify-content:space-between; gap:6px; flex-wrap:wrap; }
  .gauge { margin:0; text-align:center; flex:1 1 0; min-width:88px; }
  .gauge svg { display:block; margin:0 auto; max-width:100%; height:auto; }
  .gauge-value { font-size:30px; font-weight:800; fill:var(--ink); }
  .gauge-value-muted { fill:var(--faint); }
  .gauge-label { font-size:12px; font-weight:600; margin-top:2px; }
  .stack { display:flex; width:100%; border-radius:99px; overflow:hidden;
           background:var(--track); margin:12px 4px 0; }
  .stack.empty { color:var(--muted); font-size:12px; padding:2px 8px; background:none; }
  .stack-seg { display:block; height:100%; }
  .stack-legend { display:flex; flex-wrap:wrap; gap:12px; margin:12px 4px 14px;
                  font-size:12px; color:var(--muted); }
  .stack-key i { display:inline-block; width:9px; height:9px; border-radius:3px;
                 margin-right:5px; vertical-align:baseline; }
  .stack-key b { color:var(--ink); }

  /* ---- Info + coverage tiles ---- */
  .tiles { display:grid; grid-template-columns:repeat(auto-fit,minmax(150px,1fr)); gap:14px; }
  .tile { background:var(--card); border:1px solid var(--line); border-radius:14px;
          padding:15px 16px; box-shadow:var(--shadow); }
  .tile .k { font-size:11px; color:var(--faint); font-weight:600; text-transform:uppercase;
             letter-spacing:.06em; }
  .tile .v { font-size:19px; font-weight:700; margin-top:3px; font-variant-numeric:tabular-nums; }
  .tile .v.small { font-size:14px; font-weight:600; }

  .two-col { display:grid; grid-template-columns:1fr 1fr; gap:16px; }
  .panel-card { padding:20px 22px; }
  .panel-card h3 { font-size:14px; margin:0 0 14px; }

  /* charts */
  .hbars { display:flex; flex-direction:column; gap:9px; }
  .hbar-row { display:grid; grid-template-columns:1fr 100px auto; align-items:center; gap:10px;
              font-size:12.5px; }
  .hbar-label { color:var(--muted); overflow:hidden; text-overflow:ellipsis; white-space:nowrap; }
  .hbar-track { background:var(--track); border-radius:99px; height:8px; overflow:hidden; }
  .hbar-fill { display:block; height:100%; border-radius:99px;
               transition:width .8s cubic-bezier(.22,1,.36,1); }
  .hbar-val { font-weight:700; font-variant-numeric:tabular-nums; }

  /* ---- Findings ---- */
  h2.section { font-size:18px; margin:34px 0 4px; }
  .section-hint { color:var(--muted); font-size:13px; margin:0 0 18px; }

  .finding { background:var(--card); border:1px solid var(--line); border-radius:var(--radius);
             box-shadow:var(--shadow); margin:14px 0; overflow:hidden; position:relative;
             transition:box-shadow .2s ease, transform .2s ease; }
  .finding::before { content:""; position:absolute; top:0; left:0; bottom:0; width:4px;
                     background:var(--sev-color); }
  .finding:hover { box-shadow:0 2px 4px rgba(15,23,42,.05),0 16px 40px -18px rgba(15,23,42,.28); }
  .finding-head { display:flex; align-items:center; gap:11px; flex-wrap:wrap;
                  padding:16px 20px 14px 22px; }
  .sev-chip { display:inline-flex; align-items:center; gap:6px; font-size:11px; font-weight:800;
              letter-spacing:.03em; color:#fff; background:var(--sev-color);
              padding:4px 10px; border-radius:7px; white-space:nowrap; text-transform:uppercase; }
  .finding-title { font-size:15.5px; font-weight:700; margin:0; flex:1; min-width:200px; }
  .badge { font-size:10.5px; font-weight:700; letter-spacing:.04em; padding:3px 9px; border-radius:6px;
           border:1px solid var(--line); color:var(--muted); background:var(--panel); white-space:nowrap; }
  .badge.confirmed { color:var(--info); border-color:color-mix(in srgb,var(--info) 35%,transparent);
                     background:color-mix(in srgb,var(--info) 12%,transparent); }
  .port { color:var(--faint); font-size:12px; padding:0 22px 8px; margin:0; }
  .finding-body { padding:0 22px 20px; }

  .table-scroll { overflow-x:auto; border:1px solid var(--line); border-radius:12px; margin:6px 0 4px; }
  table.data { width:100%; border-collapse:collapse; font-size:12.5px; }
  table.data th, table.data td { padding:9px 12px; text-align:left; vertical-align:top;
                                 border-bottom:1px solid var(--line-soft); word-break:break-word;
                                 white-space:pre-line; }
  table.data tr:last-child td { border-bottom:0; }
  table.data th { background:var(--panel); font-weight:600; white-space:nowrap; color:var(--muted); }
  table.data td.num { font-variant-numeric:tabular-nums; white-space:nowrap;
                      word-break:normal; overflow-wrap:normal; }

  details.details { margin-top:14px; border-top:1px solid var(--line-soft); padding-top:6px; }
  details.details > summary { cursor:pointer; font-weight:600; font-size:12.5px; color:var(--accent);
                             padding:7px 0; list-style:none; user-select:none; }
  details.details > summary::-webkit-details-marker { display:none; }
  details.details > summary::before { content:"›"; display:inline-block; margin-right:7px;
                                      transition:transform .15s ease; }
  details.details[open] > summary::before { transform:rotate(90deg); }
  .details-body { padding:2px 0 4px; }
  .field-label { font-weight:700; font-size:12px; text-transform:uppercase; letter-spacing:.05em;
                 color:var(--faint); margin:14px 0 4px; }
  .details-body p { margin:0 0 6px; white-space:pre-line; }
  .details-body ul { margin:2px 0 6px; padding-left:18px; }
  .classification { display:grid; grid-template-columns:auto 1fr; gap:2px 16px; font-size:12.5px;
                    margin-top:4px; max-width:680px; }
  .classification dt { color:var(--muted); }
  .classification dd { margin:0; }
  pre.exchange { background:var(--panel); border:1px solid var(--line); border-radius:10px;
                 padding:12px; font-size:11.5px; overflow-x:auto; margin:6px 0;
                 white-space:pre-wrap; font-family:ui-monospace,SFMono-Regular,Menlo,monospace; }

  .empty-state { text-align:center; padding:36px; color:var(--muted); background:var(--card);
                 border:1px dashed var(--line); border-radius:var(--radius); }

  /* ---- Coverage ---- */
  ul.tests { list-style:none; padding:0; margin:0; columns:2; column-gap:28px; font-size:12.5px; }
  ul.tests li { padding:3px 0 3px 22px; position:relative; break-inside:avoid;
                -webkit-column-break-inside:avoid; color:var(--muted); }
  ul.tests li::before { content:"✓"; position:absolute; left:0; color:var(--info); font-weight:800; }

  dl.kv { display:grid; grid-template-columns:auto 1fr; gap:6px 18px; font-size:13px; margin:0; }
  dl.kv dt { color:var(--muted); }
  dl.kv dd { margin:0; font-variant-numeric:tabular-nums; }

  .errors { background:color-mix(in srgb,var(--medium) 12%,transparent);
            border:1px solid color-mix(in srgb,var(--medium) 30%,transparent);
            border-radius:12px; padding:14px 16px; font-size:12.5px; margin-top:16px; }
  .errors strong { color:var(--medium); }

  footer { margin-top:40px; padding-top:16px; border-top:1px solid var(--line);
           color:var(--faint); font-size:11.5px; display:flex; justify-content:space-between;
           gap:12px; flex-wrap:wrap; }

  @media (max-width:820px) {
    .hero { grid-template-columns:1fr; }
    .two-col { grid-template-columns:1fr; }
  }
  @media (max-width:560px) {
    .sheet { padding:24px 16px 48px; }
    ul.tests { columns:1; }
    .gauge { min-width:72px; }
  }
  @media print {
    :root { --bg:#fff; --shadow:none; }
    body { background:#fff; }
    .sheet { max-width:none; padding:0 8mm; }
    .card,.tile,.finding { box-shadow:none; break-inside:avoid; }
    .finding,table.data,li { break-inside:avoid; }
    details.details { display:block; }
    details.details > summary { display:none; }
    a { color:var(--ink); }
    h2.section { break-after:avoid; }
  }
</style>
