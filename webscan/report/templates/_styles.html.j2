<style>
  /* Premium utilitarian minimalism — warm canvas, hairline structure, ink text,
     semantic pale accents only. No gradients, no emoji, no neon. */
  :root {
    --bg:#f7f6f3; --card:#ffffff; --panel:#faf9f7;
    --ink:#23262b; --muted:#787774; --faint:#9b9a95;
    --line:#e8e6e1; --line-soft:#efede8; --track:#ecebe6;
    --accent:#1f6c9f;            /* restrained link blue */
    --cta:#161616; --cta-ink:#ffffff;
    /* severity: pale surface + deep semantic text */
    --critical:#7a1f1d; --critical-bg:#fbeaea;
    --high:#9f2f2d;     --high-bg:#fdebec;
    --medium:#8a5a00;   --medium-bg:#fbf3db;
    --low:#1f6c9f;      --low-bg:#e6f2fb;
    --info:#346538;     --info-bg:#edf3ec;
    --mono:ui-monospace,"SF Mono","Geist Mono","JetBrains Mono",Menlo,monospace;
    --sans:"SF Pro Display","Geist Sans","Helvetica Neue",system-ui,-apple-system,"Segoe UI",sans-serif;
    --radius:12px;
    --shadow:0 1px 2px rgba(0,0,0,.02);
    --shadow-hover:0 2px 8px rgba(0,0,0,.04);
  }
  @media (prefers-color-scheme:dark){ :root:not([data-theme="light"]){
    --bg:#0e0f0d; --card:#171815; --panel:#131412;
    --ink:#e7e6e1; --muted:#a09e97; --faint:#6f6e68;
    --line:#262723; --line-soft:#201f1c; --track:#242420;
    --accent:#7bb7dd; --cta:#e7e6e1; --cta-ink:#161616;
    --critical:#e08a86; --critical-bg:#2a1917; --high:#e59a97; --high-bg:#271817;
    --medium:#d9b25f; --medium-bg:#241f14; --low:#7bb7dd; --low-bg:#14202a;
    --info:#7fbd82; --info-bg:#152018;
    --shadow:0 1px 2px rgba(0,0,0,.3); --shadow-hover:0 3px 12px rgba(0,0,0,.4);
  }}
  :root[data-theme="dark"]{
    --bg:#0e0f0d; --card:#171815; --panel:#131412; --ink:#e7e6e1; --muted:#a09e97; --faint:#6f6e68;
    --line:#262723; --line-soft:#201f1c; --track:#242420; --accent:#7bb7dd; --cta:#e7e6e1; --cta-ink:#161616;
    --critical:#e08a86; --critical-bg:#2a1917; --high:#e59a97; --high-bg:#271817;
    --medium:#d9b25f; --medium-bg:#241f14; --low:#7bb7dd; --low-bg:#14202a; --info:#7fbd82; --info-bg:#152018;
    --shadow:0 1px 2px rgba(0,0,0,.3); --shadow-hover:0 3px 12px rgba(0,0,0,.4);
  }
  *{box-sizing:border-box}
  body{margin:0;background:var(--bg);color:var(--ink);font:14.5px/1.65 var(--sans);
    -webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
  .sheet{max-width:960px;margin:0 auto;padding:56px 28px 80px}
  a{color:var(--accent);text-decoration:none;word-break:break-word}
  a:hover{text-decoration:underline;text-underline-offset:2px}
  h1,h2,h3{letter-spacing:-.02em;font-weight:600}

  .masthead{display:flex;align-items:baseline;gap:14px;flex-wrap:wrap;margin-bottom:8px}
  .masthead .code{font:600 11px/1 var(--mono);letter-spacing:.14em;color:var(--muted);
    border:1px solid var(--line);border-radius:6px;padding:6px 9px;text-transform:uppercase}
  .masthead h1{font-size:23px;margin:0}
  .masthead .sub{color:var(--muted);font-size:13.5px;margin-top:4px;width:100%;
    font-family:var(--mono);letter-spacing:-.01em}
  .masthead .sub a{color:var(--ink)}
  .masthead .spacer{flex:1}
  .scan-type-pill{align-self:center;font:600 11px/1 var(--mono);letter-spacing:.08em;color:var(--muted);
    border:1px solid var(--line);padding:6px 11px;border-radius:6px;text-transform:uppercase}

  .notice{display:block;margin:24px 0 0;padding:14px 16px;border-radius:10px;background:var(--panel);
    border:1px solid var(--line-soft);color:var(--muted);font-size:12.5px}
  .notice::before{content:"Note — ";font-weight:600;color:var(--ink)}

  section.block{margin:0 0 20px}
  .eyebrow{font:600 11px/1 var(--mono);letter-spacing:.14em;text-transform:uppercase;
    color:var(--faint);margin:44px 0 14px}

  .hero{display:grid;grid-template-columns:minmax(200px,.8fr) 2fr;gap:16px;margin-top:36px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow)}
  .risk-card{padding:26px 26px;display:flex;flex-direction:column;justify-content:center;
    position:relative;overflow:hidden}
  .risk-card::before{content:"";position:absolute;inset:0 auto 0 0;width:3px;background:var(--risk-color,var(--info))}
  .risk-card .eyebrow{margin:0 0 8px}
  .risk-word{font-size:38px;font-weight:600;line-height:1;color:var(--risk-color);letter-spacing:-.03em}
  .risk-meta{margin-top:16px;font-size:12.5px;color:var(--muted);font-family:var(--mono)}
  .risk-meta b{color:var(--ink);font-weight:600}

  .gauges-card{padding:24px 20px 14px}
  .gauge-row{display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}
  .gauge{margin:0;text-align:center;flex:1 1 0;min-width:82px}
  .gauge svg{display:block;margin:0 auto;max-width:100%;height:auto}
  .gauge-value{font:600 24px var(--sans);fill:var(--ink)}
  .gauge-value-muted{fill:var(--faint)}
  .gauge-label{font:600 11px/1 var(--mono);letter-spacing:.06em;text-transform:uppercase;
    margin-top:6px;color:var(--muted)}
  .stack{display:flex;width:100%;border-radius:4px;overflow:hidden;background:var(--track);margin:16px 2px 0;height:8px}
  .stack.empty{color:var(--muted);font-size:12px;padding:2px 8px;background:none;height:auto}
  .stack-seg{display:block;height:100%}
  .stack-legend{display:flex;flex-wrap:wrap;gap:14px;margin:12px 2px 14px;font-size:12px;color:var(--muted);
    font-family:var(--mono)}
  .stack-key i{display:inline-block;width:8px;height:8px;border-radius:2px;margin-right:6px;vertical-align:baseline}
  .stack-key b{color:var(--ink)}

  .tiles{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px}
  .tile{background:var(--card);border:1px solid var(--line);border-radius:10px;padding:15px 16px;box-shadow:var(--shadow)}
  .tile .k{font:600 10.5px/1 var(--mono);color:var(--faint);text-transform:uppercase;letter-spacing:.08em}
  .tile .v{font-size:20px;font-weight:600;margin-top:6px;font-family:var(--mono);letter-spacing:-.02em}
  .tile .v.small{font-size:13px;font-weight:500}

  .two-col{display:grid;grid-template-columns:1fr 1fr;gap:16px}
  .panel-card{padding:22px 24px}
  .panel-card h3{font-size:13px;margin:0 0 16px;font-family:var(--mono);text-transform:uppercase;
    letter-spacing:.08em;color:var(--muted);font-weight:600}

  .hbars{display:flex;flex-direction:column;gap:10px}
  .hbar-row{display:grid;grid-template-columns:1fr 90px auto;align-items:center;gap:12px;font-size:12.5px}
  .hbar-label{color:var(--muted);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
  .hbar-track{background:var(--track);border-radius:2px;height:6px;overflow:hidden}
  .hbar-fill{display:block;height:100%;border-radius:2px;transition:width .8s cubic-bezier(.16,1,.3,1)}
  .hbar-val{font-weight:600;font-family:var(--mono)}

  h2.section{font-size:19px;margin:44px 0 4px;font-weight:600}
  .section-hint{color:var(--muted);font-size:13px;margin:0 0 18px}

  .finding{background:var(--card);border:1px solid var(--line);border-radius:var(--radius);box-shadow:var(--shadow);
    margin:12px 0;overflow:hidden;position:relative;transition:box-shadow .2s ease}
  .finding::before{content:"";position:absolute;top:0;left:0;bottom:0;width:3px;background:var(--sev-color)}
  .finding:hover{box-shadow:var(--shadow-hover)}
  .finding-head{display:flex;align-items:center;gap:11px;flex-wrap:wrap;padding:17px 22px 14px 24px}
  .sev-chip{display:inline-flex;align-items:center;font:600 10.5px/1 var(--mono);letter-spacing:.06em;
    color:var(--sev-color);background:var(--sev-bg);border:1px solid color-mix(in srgb,var(--sev-color) 22%,transparent);
    padding:4px 9px;border-radius:5px;text-transform:uppercase}
  .finding-title{font-size:15px;font-weight:600;margin:0;flex:1;min-width:200px;letter-spacing:-.01em}
  .badge{font:600 10px/1 var(--mono);letter-spacing:.06em;padding:4px 9px;border-radius:5px;
    border:1px solid var(--line);color:var(--faint);text-transform:uppercase}
  .badge.confirmed{color:var(--info);border-color:color-mix(in srgb,var(--info) 30%,transparent);background:var(--info-bg)}
  .port{color:var(--faint);font:12px var(--mono);padding:0 24px 8px;margin:0}
  .finding-body{padding:0 24px 22px}

  .table-scroll{overflow-x:auto;border:1px solid var(--line);border-radius:10px;margin:6px 0 4px}
  table.data{width:100%;border-collapse:collapse;font-size:12.5px}
  table.data th,table.data td{padding:9px 13px;text-align:left;vertical-align:top;
    border-bottom:1px solid var(--line-soft);word-break:break-word;white-space:pre-line}
  table.data tr:last-child td{border-bottom:0}
  table.data th{background:var(--panel);font:600 11px/1.4 var(--mono);text-transform:uppercase;
    letter-spacing:.04em;white-space:nowrap;color:var(--muted)}
  table.data td.num{font-family:var(--mono);white-space:nowrap;word-break:normal;overflow-wrap:normal}

  details.details{margin-top:14px;border-top:1px solid var(--line-soft);padding-top:6px}
  details.details>summary{cursor:pointer;font:600 12px/1 var(--mono);letter-spacing:.03em;color:var(--muted);
    padding:8px 0;list-style:none;user-select:none;text-transform:uppercase}
  details.details>summary::-webkit-details-marker{display:none}
  details.details>summary::before{content:"+";display:inline-block;margin-right:8px;font-family:var(--mono)}
  details.details[open]>summary::before{content:"−"}
  .details-body{padding:2px 0 4px}
  .field-label{font:600 11px/1 var(--mono);text-transform:uppercase;letter-spacing:.06em;color:var(--faint);margin:16px 0 5px}
  .details-body p{margin:0 0 6px;white-space:pre-line}
  .details-body ul{margin:2px 0 6px;padding-left:18px}
  .classification{display:grid;grid-template-columns:auto 1fr;gap:3px 18px;font-size:12.5px;margin-top:4px;max-width:680px}
  .classification dt{color:var(--muted);font-family:var(--mono);font-size:11.5px}
  .classification dd{margin:0}
  pre.exchange{background:var(--panel);border:1px solid var(--line);border-radius:8px;padding:12px;
    font:11.5px/1.6 var(--mono);overflow-x:auto;margin:6px 0;white-space:pre-wrap}

  .empty-state{text-align:center;padding:40px;color:var(--muted);background:var(--card);
    border:1px solid var(--line);border-radius:var(--radius);font-size:13.5px}

  ul.tests{list-style:none;padding:0;margin:0;columns:2;column-gap:32px;font-size:12.5px}
  ul.tests li{padding:4px 0 4px 20px;position:relative;break-inside:avoid;-webkit-column-break-inside:avoid;color:var(--muted)}
  ul.tests li::before{content:"›";position:absolute;left:0;color:var(--faint);font-family:var(--mono)}

  dl.kv{display:grid;grid-template-columns:auto 1fr;gap:8px 20px;font-size:13px;margin:0}
  dl.kv dt{color:var(--muted);font-family:var(--mono);font-size:12px}
  dl.kv dd{margin:0}

  .errors{background:var(--medium-bg);border:1px solid color-mix(in srgb,var(--medium) 30%,transparent);
    border-radius:10px;padding:14px 16px;font-size:12.5px;margin-top:16px}
  .errors strong{color:var(--medium)}

  footer{margin-top:48px;padding-top:18px;border-top:1px solid var(--line);color:var(--faint);
    font:11.5px var(--mono);display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap}

  @media (max-width:820px){.hero{grid-template-columns:1fr}.two-col{grid-template-columns:1fr}}
  @media (max-width:560px){.sheet{padding:32px 16px 48px}ul.tests{columns:1}.gauge{min-width:64px}}
  @media print{
    :root{--bg:#fff;--shadow:none;--shadow-hover:none}
    body{background:#fff}
    .sheet{max-width:none;padding:0 8mm}
    .card,.tile,.finding{box-shadow:none;break-inside:avoid}
    .finding,table.data,li{break-inside:avoid}
    details.details{display:block}details.details>summary{display:none}
    a{color:var(--ink)}h2.section{break-after:avoid}
  }
</style>
