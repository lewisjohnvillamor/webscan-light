<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Website Vulnerability Scanner Report — {{ result.target }}</title>
{% include "_styles.html.j2" %}
</head>
<body>
<div class="sheet">

  <header class="masthead">
    <div class="glyph">🛡</div>
    <div>
      <h1>Website Vulnerability Scanner Report</h1>
      <div class="sub">Target: <a href="{{ result.target }}">{{ result.target }}</a></div>
    </div>
    <span class="spacer"></span>
    <span class="scan-type-pill">{{ result.scan_type }} scan</span>
  </header>

  {% if scanner_note %}<div class="notice">{{ scanner_note }}</div>{% endif %}

  {% set risk = result.overall_risk.label %}
  <section class="block hero">
    <div class="card risk-card" style="--risk-color:var({{ severity_vars[risk] }})">
      <div class="eyebrow">Overall risk level</div>
      <div class="risk-word">{{ risk }}</div>
      <div class="risk-meta">
        <b>{{ charts.total_findings }}</b> finding{{ '' if charts.total_findings == 1 else 's' }}
        · <b>{{ charts.confirmed }}</b> confirmed
        · <b>{{ result.tests_performed|length }}</b> tests
      </div>
    </div>
    <div class="card gauges-card">
      <div class="gauge-row">
        {% for gauge in charts.gauges %}{{ gauge }}{% endfor %}
      </div>
      {{ charts.stack }}
    </div>
  </section>

  <section class="block tiles">
    <div class="tile"><div class="k">Start time</div><div class="v small">{{ result.start_time|localtime }}</div></div>
    <div class="tile"><div class="k">Finish time</div><div class="v small">{{ result.finish_time|localtime }}</div></div>
    <div class="tile"><div class="k">Scan duration</div><div class="v">{{ result.duration_seconds }}<span style="font-size:13px;font-weight:500;color:var(--muted)"> sec</span></div></div>
    <div class="tile"><div class="k">Tests performed</div><div class="v">{{ result.tests_performed|length }}</div></div>
    <div class="tile"><div class="k">URLs spidered</div><div class="v">{{ result.stats.urls_spidered }}</div></div>
    <div class="tile"><div class="k">HTTP requests</div><div class="v">{{ result.stats.http_requests }}</div></div>
    <div class="tile"><div class="k">Injection points</div><div class="v">{{ result.stats.unique_injection_points }}</div></div>
    <div class="tile"><div class="k">Avg. response</div><div class="v">{{ result.stats.average_response_ms }}<span style="font-size:13px;font-weight:500;color:var(--muted)"> ms</span></div></div>
  </section>

  {% if charts.owasp_chart %}
  <section class="block two-col">
    <div class="card panel-card">
      <h3>Findings by OWASP Top 10 (2021)</h3>
      {{ charts.owasp_chart }}
    </div>
    <div class="card panel-card">
      <h3>Confidence</h3>
      <div class="hbars">
        <div class="hbar-row"><span class="hbar-label">Confirmed</span>
          <span class="hbar-track"><span class="hbar-fill" style="width:{{ (100 * charts.confirmed / charts.total_findings) if charts.total_findings else 0 }}%;background:var(--info)"></span></span>
          <span class="hbar-val">{{ charts.confirmed }}</span></div>
        <div class="hbar-row"><span class="hbar-label">Unconfirmed</span>
          <span class="hbar-track"><span class="hbar-fill" style="width:{{ (100 * charts.unconfirmed / charts.total_findings) if charts.total_findings else 0 }}%;background:var(--faint)"></span></span>
          <span class="hbar-val">{{ charts.unconfirmed }}</span></div>
      </div>
      <p class="section-hint" style="margin-top:14px">Confirmed findings were directly observed. Unconfirmed findings are version- or heuristic-based and warrant manual verification.</p>
    </div>
  </section>
  {% endif %}

  <h2 class="section">Findings</h2>
  {% if not result.findings %}
    <div class="empty-state">No issues were identified by the {{ result.tests_performed|length }} tests that were run.</div>
  {% else %}
  <p class="section-hint">{{ charts.total_findings }} findings, highest severity first.</p>
  {% endif %}

  {% for finding in result.sorted_findings %}
  <article class="finding" style="--sev-color:var({{ severity_vars[finding.severity.label] }})">
    <div class="finding-head">
      <span class="sev-chip">{{ finding.severity.label }}</span>
      <h3 class="finding-title">{{ finding.title }}</h3>
      <span class="badge {{ 'confirmed' if finding.confidence.value == 'CONFIRMED' else '' }}">{{ finding.confidence.value }}</span>
    </div>
    {% if finding.port %}<p class="port">port {{ finding.port }}</p>{% endif %}
    <div class="finding-body">
      {% if finding.table and finding.table.rows %}
      <div class="table-scroll">
        <table class="data">
          <thead><tr>{% for column in finding.table.columns %}<th>{{ column }}</th>{% endfor %}</tr></thead>
          <tbody>
            {% for row in finding.table.rows %}
            <tr>{% for cell in row %}<td{{ ' class="num"' if finding.table.columns[loop.index0] in numeric_columns else '' }}>{{ cell|linkify }}</td>{% endfor %}</tr>
            {% endfor %}
          </tbody>
        </table>
      </div>
      {% endif %}

      <details class="details" open>
        <summary>Details, recommendation &amp; classification</summary>
        <div class="details-body">
          {% if finding.risk_description %}
          <div class="field-label">Risk description</div>
          <p>{{ finding.risk_description }}</p>
          {% endif %}
          {% if finding.recommendation %}
          <div class="field-label">Recommendation</div>
          <p>{{ finding.recommendation }}</p>
          {% endif %}
          {% if finding.references %}
          <div class="field-label">References</div>
          <ul>{% for reference in finding.references %}<li><a href="{{ reference }}">{{ reference }}</a></li>{% endfor %}</ul>
          {% endif %}
          {% if finding.classification.as_rows() %}
          <div class="field-label">Classification</div>
          <dl class="classification">
            {% for label, value in finding.classification.as_rows() %}
            <dt>{{ label }}</dt><dd>{{ value }}</dd>
            {% endfor %}
          </dl>
          {% endif %}
          {% if include_exchanges and finding.request_response %}
          <div class="field-label">Request / Response</div>
          <pre class="exchange">{{ finding.request_response }}</pre>
          {% endif %}
        </div>
      </details>
    </div>
  </article>
  {% endfor %}

  <h2 class="section">Scan coverage</h2>
  <p class="section-hint">{{ result.tests_performed|length }} tests performed{% if result.ports %} on port{{ 's' if result.ports|length > 1 else '' }} {{ result.ports|join(', ') }}{% endif %}.</p>
  <div class="card panel-card">
    <ul class="tests">
      {% for test in result.tests_performed %}<li>{{ test }}</li>{% endfor %}
    </ul>
  </div>

  <section class="block two-col" style="margin-top:22px">
    <div class="card panel-card">
      <h3>Scan parameters</h3>
      <dl class="kv">
        <dt>Target</dt><dd style="font-variant-numeric:normal">{{ result.target }}</dd>
        <dt>Scan type</dt><dd style="font-variant-numeric:normal">{{ result.scan_type }}</dd>
        <dt>Authentication</dt><dd style="font-variant-numeric:normal">{{ result.authentication }}</dd>
      </dl>
    </div>
    <div class="card panel-card">
      <h3>Scan stats</h3>
      <dl class="kv">
        <dt>Unique injection points</dt><dd>{{ result.stats.unique_injection_points }}</dd>
        <dt>URLs spidered</dt><dd>{{ result.stats.urls_spidered }}</dd>
        <dt>Total HTTP requests</dt><dd>{{ result.stats.http_requests }}</dd>
        <dt>Average response time</dt><dd>{{ result.stats.average_response_ms }} ms</dd>
      </dl>
    </div>
  </section>

  {% if result.errors %}
  <div class="errors">
    <strong>Scan notes</strong>
    <ul style="margin:6px 0 0;padding-left:18px">
      {% for error in result.errors %}<li>{{ error }}</li>{% endfor %}
    </ul>
  </div>
  {% endif %}

  <footer>
    <span>Generated by webscan-light v{{ version }}</span>
    <span>{{ generated_at|localtime }}</span>
  </footer>
</div>
</body>
</html>
